# Copy to your hosting provider's environment settings (this app doesn't read .env files itself).
NODE_ENV=production
# Required in production. Generate with: openssl rand -hex 32
JWT_SECRET=
PORT=3001
# Optional: where the SQLite file lives (default server/data/app.db)
# DB_PATH=/var/data/app.db
# Optional: where the built React app is (default client/dist)
# CLIENT_DIST=/app/client/dist
# Only for trying the production build over plain http://localhost (Secure cookies need HTTPS)
# COOKIE_SECURE=false
